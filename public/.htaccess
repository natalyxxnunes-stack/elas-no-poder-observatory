# Quem são elas? — configuração Apache para o build estático (HostGator).
# Suba o conteúdo de dist/client/ (este arquivo incluído) para public_html.

Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

Redirect 301 /condicoes /quem-controla

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonicaliza o domínio sem www, preservando caminho e querystring.
  RewriteCond %{HTTP_HOST} ^www\.quemsaoelas\.com\.br$ [NC]
  RewriteRule ^ https://quemsaoelas.com.br%{REQUEST_URI} [L,R=301]

  # Força HTTPS: o site lê o banco via fetch e conteúdo misto é bloqueado.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Temas migrados no redesign de 15/11: redirecionar rotas antigas,
  # inclusive quando pastas de builds anteriores ainda existirem na HostGator.
  RewriteRule ^temas/cor-e-raca/?$ /temas/presenca/ [R=301,L]
  RewriteRule ^temas/direitos/?$ /direitos/ [R=301,L]
  RewriteRule ^temas/democracia/?$ /temas/agenda/ [R=301,L]

  # 1) Rota pré-renderizada: /metodo → /metodo/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]


  # 2) Arquivo existente (assets, CSV, imagens) é servido como está.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Rotas e arquivos inexistentes retornam HTTP 404 real.
  RewriteRule ^ - [R=404,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/csv application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Sem hash, revalidar em prazo curto (inclusive fotografias e documentos).
  <FilesMatch "[.](js|css|woff2|png|jpg|jpeg|webp|svg|avif|pdf|csv|json)$">
    ExpiresDefault "access plus 1 hour"
  </FilesMatch>
  # HTML precisa revalidar: cada nova fotografia publicada gera HTML novo.
  <FilesMatch "[.]html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "[.](js|css|woff2|png|jpg|jpeg|webp|svg|avif|pdf|csv|json)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Somente assets versionados por hash emitidos no build.
  <If "%{REQUEST_URI} =~ m#^/assets/[^/]+-[A-Za-z0-9_-]{8,}[.](js|css|woff2)$#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "[.]html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddType text/csv .csv
AddCharset UTF-8 .html .css .js .csv
