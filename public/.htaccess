# Quem são elas? — configuração Apache para o build estático (HostGator).
# Suba o conteúdo de .output/public/ (este arquivo incluído) para public_html.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS: o site lê o banco via fetch e conteúdo misto é bloqueado.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Rota despublicada no site: mantém o endereço vivo apontando para a home.
  RewriteRule ^historico/?$ / [L,R=301]

  # 1) Rota pré-renderizada: /metodo → /metodo/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]


  # 2) Arquivo existente (assets, CSV, imagens) é servido como está.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Qualquer outra rota cai no app (fallback de SPA); a página 404 do
  #    próprio site trata endereços inexistentes.
  RewriteRule ^ /_shell.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/csv application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Assets com hash no nome podem ser cacheados longamente.
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|svg|avif)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML precisa revalidar: cada nova fotografia publicada gera HTML novo.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

AddType text/csv .csv
AddCharset UTF-8 .html .css .js .csv
